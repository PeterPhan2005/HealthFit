{
	"info": {
		"_postman_id": "healthfit-auth-collection",
		"name": "HealthFit - Auth Service",
		"description": "Authentication API endpoints for HealthFit application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123\",\n  \"fullName\": \"John Doe\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"gender\": \"MALE\",\n  \"currentWeight\": 75.5,\n  \"currentHeight\": 175.0,\n  \"activityLevel\": \"MODERATELY_ACTIVE\"\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/auth/register",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Register a new user account.\n\n**Request Body:**\n- email: User email (required, unique)\n- password: Password (required, min 8 chars)\n- fullName: Full name (required)\n- dateOfBirth: Date of birth in YYYY-MM-DD format (required)\n- gender: MALE, FEMALE, or OTHER (required)\n- currentWeight: Current weight in kg (required)\n- currentHeight: Current height in cm (optional)\n- activityLevel: SEDENTARY, LIGHTLY_ACTIVE, MODERATELY_ACTIVE, VERY_ACTIVE, EXTREMELY_ACTIVE (optional)\n\n**Response:**\n- token: JWT access token\n- user: User details"
					},
					"response": []
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePass123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login with email and password.\n\n**Request Body:**\n- email: User email\n- password: User password\n\n**Response:**\n- token: JWT access token\n- user: User details"
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/auth/me",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Get currently authenticated user's profile.\n\n**Headers:**\n- Authorization: Bearer {token}\n\n**Response:**\n- User profile details"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Logout user by blacklisting the current JWT token.\n\n**Headers:**\n- Authorization: Bearer {token}\n\n**Response:**\n- Success message\n\n**Note:** After logout, the token will be invalidated and cannot be used again."
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/auth/health",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"health"
							]
						},
						"description": "Check if Auth Service is running"
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
}